<?xml version="1.0" encoding="utf-8"?>
<!-- The Beszel hub and camview's Relay are plain HTTP on the LAN; everything
     else stays HTTPS-only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.0.20</domain>
    </domain-config>
</network-security-config>
