<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Holds Wi-Fi in its low-latency mode while the Camera is on screen. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Self-updates from GitHub Releases, without a tap after the first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- The launcher menu opens the tablet's other apps by package name. -->
    <queries>
        <package android:name="com.chriscorbell.camview" />
        <package android:name="com.mcu.reolink" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="com.android.launcher3" />
        <package android:name="com.android.settings" />
    </queries>

    <application
        android:enableOnBackInvokedCallback="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Visor">

        <!-- The desk display's home screen: it starts on boot, Home always
             brings it back, and it stays landscape either way up. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:stateNotNeeded="true">
            <!-- Android 16 ignores orientation requests on tablets unless the
                 app opts out, and visor's grid is built for landscape only. -->
            <property
                android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
                android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".Updater$InstallResult"
            android:exported="false" />

        <receiver
            android:name=".StayInFront$AfterUpdate"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
